;; com.enterprise.enclave.ifc — enclave-agent-runtime (UID 704). Deny by default.
(version 1)
(deny default)
(import "bsd.sb")
(allow process-exec (literal "/opt/enterprise/enclave/bin/enclave-agent-runtime"))
(allow file-read* (literal "/opt/enterprise/enclave/bin/enclave-agent-runtime"))
;; Peer executable code signature reading (SecCodeCopyGuestWithAttributes)
(allow file-read* (subpath "/opt/enterprise/enclave/bin"))
(allow file-read* (subpath "/Library/Application Support/EnterpriseEnclave/EnclaveCustody.app"))
;; Reapply the same root-provisioned confinement in shared runtime (FUNC-005).
(allow file-read* (literal "/opt/enterprise/enclave/sandbox/ifc.sb"))
(allow file-read-metadata (subpath "/opt/enterprise/enclave/sandbox"))
(allow file-read-data file-read-metadata (literal "/opt/enterprise/enclave/sandbox"))
(allow file-read-data file-read-metadata (literal "/opt/enterprise/enclave"))
(allow file-read-data file-read-metadata (literal "/opt/enterprise"))
(allow file-read-data file-read-metadata (literal "/opt"))
(allow file-read-data file-read-metadata (literal "/"))
(allow file-read* (literal "/Library/Application Support/EnterpriseEnclave/codesign-pins.json"))
(allow file-read-metadata (literal "/Library/Application Support/EnterpriseEnclave"))
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup (global-name "com.apple.system.logger"))
;; Peer code-identity verification (Security.framework / SecCode)
(allow mach-lookup (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc"))
;; System power monitoring (GAP-16)
(allow iokit-open (iokit-user-client-class "IOPMrootDomain"))
(allow mach-lookup (global-name "com.apple.iokit.powerdxpc") (global-name "com.apple.PowerManagement.control"))
;; Supervisor Mach exception port (GAP-12)
(allow mach-lookup (global-name "com.enterprise.enclave.exception"))
(allow file-read* (subpath "/usr/lib") (subpath "/System/Library") (literal "/dev/urandom") (literal "/dev/random"))
(allow file-read-metadata (literal "/private/var/run/enclave") (literal "/private/var/log/enclave"))
(allow file-read* file-write* (subpath "/private/var/run/enclave/ifc") (subpath "/private/var/log/enclave/ifc"))
(allow file-read* file-write* (subpath "/private/var/db/enclave/ifc"))
(allow network-bind network-inbound (local unix-socket (subpath "/private/var/run/enclave/ifc")))
(allow network-outbound (remote unix-socket (subpath "/private/var/run/enclave")))
;; F71: positively bind incarnation watches before recoverable turn allocation.
(allow process-info-pidinfo)
