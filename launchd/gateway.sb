;; Console ingress: socket is connectable but every peer is UID+code authenticated.
(version 1)
(deny default)
(import "bsd.sb")
(allow process-exec (literal "/opt/enterprise/enclave/bin/enclave-client-gateway"))
(allow file-read* (subpath "/opt/enterprise/enclave/bin") (subpath "/usr/lib") (subpath "/System/Library"))
(allow file-read* (literal "/Library/Application Support/EnterpriseEnclave/codesign-pins.json") (literal "/dev/urandom") (literal "/dev/random"))
(allow file-read-metadata (literal "/dev/console") (literal "/private/var/run/enclave") (literal "/private/var/run/enclave/ifc") (literal "/private/var/run/enclave/ifc/ifc.sock") (literal "/Library/Application Support/EnterpriseEnclave"))
(allow file-read* file-write* (subpath "/private/var/run/enclave/gateway"))
(allow network-bind network-inbound (local unix-socket (subpath "/private/var/run/enclave/gateway")))
(allow network-outbound (remote unix-socket (literal "/private/var/run/enclave/ifc/ifc.sock")))
(allow mach-lookup (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc"))
(allow signal (target self))
(allow sysctl-read)
