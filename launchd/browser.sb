;; com.enterprise.enclave.browser — enclave-cdp-browser (UID 707). Deny by default.
(version 1)
(deny default)
(import "bsd.sb")
(allow process-exec (literal "/opt/enterprise/enclave/bin/enclave-cdp-browser"))
(allow file-read* (literal "/opt/enterprise/enclave/bin/enclave-cdp-browser"))
(allow signal (target self))
(allow sysctl-read)
(allow file-read-metadata (literal "/private/var/run/enclave") (literal "/private/var/log/enclave") (literal "/private/var/db/enclave"))
(allow file-read* file-write* (subpath "/private/var/run/enclave/browser") (subpath "/private/var/log/enclave/browser") (subpath "/private/var/db/enclave/browser"))
(allow network-bind network-inbound (local unix-socket (subpath "/private/var/run/enclave/browser")))
(allow file-read* file-write* (subpath "/private/tmp/enclave-browser"))
(allow process-exec (literal "/Library/Application Support/EnterpriseEnclave/browser/Google Chrome.app/Contents/MacOS/Google Chrome") (literal "/Library/Application Support/EnterpriseEnclave/browser/Chromium.app/Contents/MacOS/Chromium"))
(allow file-read* (subpath "/Library/Application Support/EnterpriseEnclave/browser/Google Chrome.app") (subpath "/Library/Application Support/EnterpriseEnclave/browser/Chromium.app"))
